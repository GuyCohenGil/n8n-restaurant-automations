          }
        ]
      ]
    },
    "Read Delivery Note": {
      "main": [
        [
          {
            "node": "Validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate": {
      "main": [
        [
          {
            "node": "Is Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Valid?": {
      "main": [
        [
          {
            "node": "Split Lines",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Invalid Note",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Lines": {
      "main": [
        [
          {
            "node": "Compare To Agreed Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compare To Agreed Price": {
      "main": [
        [
          {
            "node": "Collect Lines",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Lines": {
      "main": [
        [
          {
            "node": "Build Check Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Check Result": {
      "main": [
        [
          {
            "node": "Respond With Check Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond With Check Result": {
      "main": [
        [
          {
            "node": "Any Price Deviations?",
