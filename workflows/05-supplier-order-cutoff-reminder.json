      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        96
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "3a7aa3e9-5a32-4526-ae64-114839105a46",
      "name": "Load Supplier Schedule",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "l1",
              "name": "suppliers",
              "type": "array",
              "value": "={{ [\n  { name: \"ירקות השרון\", days: [0, 1, 2, 3, 4], cutoff: \"14:00\", channel: \"וואטסאפ\" },\n  { name: \"עופות הגליל\", days: [0, 2, 4], cutoff: \"12:00\", channel: \"טלפון\" },\n  { name: \"מחלבת הכפר\", days: [1, 3], cutoff: \"16:00\", channel: \"וואטסאפ\" },\n  { name: \"טחנות הצפון\", days: [2], cutoff: \"10:00\", channel: \"מייל\" }\n] }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6e7dd765-5e69-44b5-b73c-e26e2b22c7ff",
      "name": "Split Suppliers",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        448,
        96
      ],
      "parameters": {
        "fieldToSplitOut": "suppliers",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "02191ebf-9ec7-44f1-a9e5-dcdd85acc2d5",
      "name": "Valid Schedule Row?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ !!$json.name && Array.isArray($json.days) && /^([01]\\d|2[0-3]):[0-5]\\d$/.test(String($json.cutoff ?? \"\")) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "d49de2b5-ea35-40eb-bca7-52b4ebd86bc1",
      "name": "Orders Today?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "today",
              "leftValue": "={{ $json.days.includes($now.setZone(\"Asia/Jerusalem\").weekday % 7) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b5e04bc3-6b95-4e09-bb37-316751b5e73d",
      "name": "Sort By Cutoff",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "type": "simple",
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "cutoff",
              "order": "ascending"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a7c91774-328b-44cb-8bc6-d366ad222a06",
      "name": "Collect Today's Suppliers",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "today",
        "options": {}
      }
