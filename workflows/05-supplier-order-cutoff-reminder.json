    {
      "id": "5c0594ea-e336-4042-9403-e83e8e140290",
      "name": "Build Reminder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "count",
              "type": "number",
              "value": "={{ $json.today.length }}"
            },
            {
              "id": "r2",
              "name": "message",
              "type": "string",
              "value": "=<b>תזכורת הזמנות להיום – יום {{ [\"ראשון\", \"שני\", \"שלישי\", \"רביעי\", \"חמישי\", \"שישי\", \"שבת\"][$now.setZone(\"Asia/Jerusalem\").weekday % 7] }}</b>\n\n{{ $json.today.map(s => \"• \" + s.name + \": עד \" + s.cutoff + \" (\" + s.channel + \")\").join(\"\\n\") }}\n\nטיוטות ההזמנה מהספירה של אתמול מחכות לאישור."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "07eb7e31-3a86-4f6e-a072-0257599ca90c",
      "name": "Send Cutoff Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "retryOnFail": true
    },
    {
      "id": "b207c229-79b7-48f2-8f3a-2b296b0903cf",
