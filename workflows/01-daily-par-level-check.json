{
  "name": "DEMO R1 - Daily Par Level Check",
  "nodes": [
    {
      "id": "2235ab63-29ab-4778-b1ac-7f9241caede3",
      "name": "Every Day 15:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 15,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "3551b196-3f0e-4c67-b5b3-1a7a2cf3db7f",
      "name": "Load Inventory Count",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "counts",
              "type": "array",
              "value": "={{ [\n  { item: \"עגבניות\", unit: \"ק״ג\", onHand: 4, par: 12, supplier: \"ירקות השרון\" },\n  { item: \"מלפפונים\", unit: \"ק״ג\", onHand: 9, par: 8, supplier: \"ירקות השרון\" },\n  { item: \"בצל\", unit: \"ק״ג\", onHand: 3, par: 10, supplier: \"ירקות השרון\" },\n  { item: \"חזה עוף\", unit: \"ק״ג\", onHand: 6, par: 15, supplier: \"עופות הגליל\" },\n  { item: \"שמנת 38%\", unit: \"ליטר\", onHand: 2, par: 6, supplier: \"מחלבת הכפר\" },\n  { item: \"חמאה\", unit: \"ק״ג\", onHand: 5, par: 4, supplier: \"מחלבת הכפר\" },\n  { item: \"קמח לבן\", unit: \"ק״ג\", onHand: 20, par: 25, supplier: \"טחנות הצפון\" }\n] }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3f24ffd2-0313-4f8a-92ba-874ed38573c2",
      "name": "Split Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "counts",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "97f193d2-29fa-40a9-bcb3-ea17c1e79116",
      "name": "Below Par Level?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "below",
              "leftValue": "={{ $json.onHand }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "rightValue": "={{ $json.par }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0b302cf9-a15a-4d18-b76c-a8cd5be9c4b0",
      "name": "Calculate Order Line",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "o1",
              "name": "orderQty",
              "type": "number",
              "value": "={{ $json.par - $json.onHand }}"
            },
            {
              "id": "o2",
              "name": "line",
              "type": "string",
              "value": "=• {{ $json.item }}: להזמין {{ $json.par - $json.onHand }} {{ $json.unit }} (במלאי {{ $json.onHand }}, מינימום {{ $json.par }})"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "887a7110-900b-4d18-bd30-4ffac4eb5d69",
      "name": "Group By Supplier",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "concatenate",
              "field": "line",
              "separateBy": "\n"
            },
            {
              "aggregation": "count",
              "field": "item"
            }
          ]
        },
        "fieldsToSplitBy": "supplier",
        "options": {}
      }
    },
    {
      "id": "529fc2ac-e9b9-48e3-9747-c148e5769044",
      "name": "Collect Suppliers",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "suppliers",
        "options": {}
      }
    },
    {
      "id": "6157326a-dffc-4333-92e9-71baad775b4b",
      "name": "Build Order Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "m1",
              "name": "itemsCount",
              "type": "number",
              "value": "={{ $json.suppliers.reduce((sum, s) => sum + s.count_item, 0) }}"
            },
            {
              "id": "m2",
              "name": "message",
              "type": "string",
              "value": "=<b>טיוטת הזמנות לאישור – {{ $now.setZone(\"Asia/Jerusalem\").toFormat(\"dd/MM\") }}</b>\n{{ $json.suppliers.reduce((sum, s) => sum + s.count_item, 0) }} פריטים מתחת לרמת המינימום\n\n{{ $json.suppliers.map(s => \"<b>\" + s.supplier + \"</b>\\n\" + s.concatenated_line).join(\"\\n\\n\") }}\n\nההזמנות עדיין לא נשלחו לספקים. נא לאשר."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1671d317-1732-45dd-899f-c8bf11b81b96",
      "name": "Send Order Drafts to Manager",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2016,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "retryOnFail": true
    },
    {
      "id": "c2f382f7-e648-4873-a5f2-1a3a807bf654",
      "name": "Sticky Note d9d06403",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ],
      "parameters": {
        "content": "## DEMO R1 - Daily Par Level Check\nכל יום ב-15:00: ספירת מלאי -> פיצול לפריטים -> Valid Count Row? -> Below Par Level? -> חישוב כמות להזמנה -> קיבוץ לפי ספק -> הודעת טיוטה למנהל לאישור.\nשורת ספירה לא תקינה -> Stop and Error -> התראה. אין פריטים מתחת למינימום -> לא נשלחת הודעה.\nנתוני ההדגמה ב-Load Inventory Count. בעבודה אמיתית: טבלת המלאי ב-Airtable.\nצריך: Telegram.",
        "width": 560,
        "height": 260,
        "color": 4
      }
    },
    {
      "id": "0bc452d6-0422-4816-909c-bfbbadb2508c",
      "name": "Valid Count Row?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "valid-row",
              "leftValue": "={{ typeof $json.onHand === 'number' && typeof $json.par === 'number' && !!$json.item && !!$json.supplier }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      }
    },
    {
      "id": "3bb6c108-a354-4229-82e4-bdac437db781",
      "name": "Reject Invalid Count",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        896,
        224
      ],
      "parameters": {
        "errorMessage": "=שורת ספירה לא תקינה (חסר פריט, ספק, כמות או מינימום): {{ JSON.stringify($json) }}",
        "errorType": "errorMessage"
      }
    }
  ],
  "connections": {
    "Every Day 15:00": {
      "main": [
        [
          {
            "node": "Load Inventory Count",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Inventory Count": {
      "main": [
        [
          {
            "node": "Split Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Below Par Level?": {
      "main": [
        [
          {
            "node": "Calculate Order Line",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Order Line": {
      "main": [
        [
          {
            "node": "Group By Supplier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Group By Supplier": {
      "main": [
        [
          {
            "node": "Collect Suppliers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Suppliers": {
      "main": [
        [
          {
            "node": "Build Order Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Order Message": {
      "main": [
        [
          {
            "node": "Send Order Drafts to Manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Items": {
      "main": [
        [
          {
            "node": "Valid Count Row?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid Count Row?": {
      "main": [
        [
          {
            "node": "Below Par Level?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Invalid Count",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jerusalem"
  },
