              "name": "note",
              "type": "string",
              "value": "={{ String($json.body?.note ?? \"\").trim() }}"
            },
            {
              "id": "r6",
              "name": "validationError",
              "type": "string",
              "value": "={{ [!String($json.body?.supplier ?? \"\").trim() ? \"חסר ספק\" : \"\", !String($json.body?.item ?? \"\").trim() ? \"חסר פריט\" : \"\", !(Number($json.body?.packs) > 0) ? \"כמות חייבת להיות גדולה מ-0\" : \"\", ![\"אירוע\", \"ספיישל\", \"אחר\"].includes(String($json.body?.reason ?? \"\").trim()) ? \"סיבה חייבת להיות אירוע, ספיישל או אחר\" : \"\"].filter(e => e).join(\"; \") }}"
            }
          ]
        },
        "options": {}
