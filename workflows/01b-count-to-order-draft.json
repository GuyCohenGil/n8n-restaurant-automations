              "value": "={{ (($(\"Get Supplier\").first().json.fields[\"Order Days\"] || []).map(d => [\"ראשון\", \"שני\", \"שלישי\", \"רביעי\", \"חמישי\", \"שישי\", \"שבת\"].indexOf(d)).sort((a, b) => a - b).find(d => d > $now.setZone(\"Asia/Jerusalem\").weekday % 7) ?? ((($(\"Get Supplier\").first().json.fields[\"Order Days\"] || []).map(d => [\"ראשון\", \"שני\", \"שלישי\", \"רביעי\", \"חמישי\", \"שישי\", \"שבת\"].indexOf(d)).sort((a, b) => a - b)[0] ?? 0) + 7)) - $now.setZone(\"Asia/Jerusalem\").weekday % 7 }}"
