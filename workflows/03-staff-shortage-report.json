{
  "name": "DEMO R3 - Staff Shortage Report",
  "nodes": [
    {
      "id": "a12fb38e-0511-461b-a0b4-7baee0e4663f",
      "name": "Staff Message Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        96
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "demo-r3-shortage",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "f42e278c-3652-4262-94b4-f4e1dd59104f"
    },
    {
      "id": "e90a90f6-2335-4641-adf5-189b28fe4ffe",
      "name": "Read Staff Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "from",
              "type": "string",
              "value": "={{ String($json.body?.from ?? \"צוות\").trim() || \"צוות\" }}"
            },
            {
              "id": "s2",
              "name": "text",
              "type": "string",
              "value": "={{ String($json.body?.text ?? \"\").trim() }}"
            },
            {
              "id": "s3",
              "name": "items",
              "type": "array",
              "value": "={{ String($json.body?.text ?? \"\").trim().replace(/^(נגמרו|נגמרה|נגמר|חסרים|חסרה|חסר|אין)\\s+/, \"\").split(/,|\\n|\\s+ו(?=[א-ת])/).map(s => s.trim()).filter(s => s) }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6cb70314-c33f-47dc-bf2b-c12b58ce8e21",
      "name": "Items Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ $json.items }}",
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4dea57f6-955a-416a-91a2-899a5551e47a",
      "name": "Build Replies",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "reply",
              "type": "string",
              "value": "=תודה, רשמתי: {{ $json.items.join(\", \") }}. המנהל עודכן."
            },
            {
              "id": "b2",
              "name": "managerMessage",
              "type": "string",
              "value": "=<b>דיווח חוסר מהצוות</b>\nמאת: {{ $json.from.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\") }} · {{ $now.setZone(\"Asia/Jerusalem\").toFormat(\"HH:mm\") }}\n\n{{ $json.items.map(i => \"• \" + i.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\")).join(\"\\n\") }}\n\nנוסף לרשימת ההזמנה הבאה."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5a15cc3d-0613-4b0a-bd86-c816db11bce7",
      "name": "Reply to Staff Member",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"received\", \"items\": $json.items, \"reply\": $json.reply } }}",
        "options": {}
      }
    },
    {
      "id": "49f5a21a-a6c3-4648-b98f-8b1ca6264a8c",
      "name": "Notify Manager of Shortage",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.managerMessage }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "retryOnFail": true
    },
    {
      "id": "621a2a17-ff8e-4490-91aa-9156c05eca8b",
      "name": "Reject Empty Message",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        672,
        192
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=הודעת חוסר ריקה או שלא זוהו בה פריטים. מאת: {{ $json.from }}, טקסט: \"{{ $json.text }}\""
      }
    },
    {
      "id": "b51da3e0-3cf1-4433-ab2c-ef6b3d876b9c",
      "name": "Sticky Note 8c8829a5",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ],
      "parameters": {
        "content": "## DEMO R3 - Staff Shortage Report\nעובד כותב בטקסט חופשי, למשל \"נגמרו עגבניות, שמנת ובצל סגול\" -> Read Staff Message (פירוק לפריטים ב-expression) -> Items Found?\nלא נמצאו פריטים -> Stop and Error -> התראה מ-_system - Error Alerts.\nנמצאו -> תשובה לעובד + עדכון למנהל.\nבעבודה אמיתית: ה-Webhook מוחלף בטריגר של WhatsApp Business Cloud.\nצריך: Telegram.",
        "width": 560,
        "height": 260,
        "color": 4
      }
    }
  ],
