{
  "name": "DEMO R1a - Daily Count List",
  "nodes": [
    {
      "id": "69d00b92-2187-4c8e-84f0-16f9e9f48c0d",
      "name": "Every Day 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        96
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "01d4de9a-0c16-40fb-b0d9-34dafd792b2d",
      "name": "Read Today",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "dayName",
              "type": "string",
              "value": "={{ [\"ראשון\", \"שני\", \"שלישי\", \"רביעי\", \"חמישי\", \"שישי\", \"שבת\"][$now.setZone(\"Asia/Jerusalem\").weekday % 7] }}"
            },
            {
              "id": "t2",
              "name": "date",
              "type": "string",
              "value": "={{ $now.setZone(\"Asia/Jerusalem\").toFormat(\"dd/MM\") }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "04ccbba4-a164-4717-9bf1-ec7c607bb551",
      "name": "Get Today's Suppliers",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Suppliers"
        },
        "filterByFormula": "=AND({Active}, FIND(\"{{ $json.dayName }}\", ARRAYJOIN({Order Days})))",
        "returnAll": true,
        "options": {},
        "sort": {
          "property": [
            {
              "field": "Cutoff",
              "direction": "asc"
            }
          ]
        },
        "authentication": "airtableOAuth2Api"
      },
      "retryOnFail": true
    },
    {
      "id": "99e7951f-747f-4b6f-9487-184d02428080",
      "name": "Collect Suppliers",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        672,
        96
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "suppliers",
        "options": {}
      }
    },
    {
      "id": "d62a6a2d-ad9d-4dd1-b943-3f38c5ba8bd3",
      "name": "Get Their Items",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Items"
        },
        "filterByFormula": "=AND({Active}, OR({{ $json.suppliers.map(s => 'FIND(\"' + s.fields.Supplier + '\", ARRAYJOIN({Supplier Name}))').join(\", \") }}))",
        "returnAll": true,
        "options": {},
        "authentication": "airtableOAuth2Api"
      },
      "retryOnFail": true
    },
    {
      "id": "52b0cfb9-3040-4ba8-bad9-ed6e395564c2",
      "name": "Prepare Count Line",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "supplier",
              "type": "string",
              "value": "={{ ($json.fields[\"Supplier Name\"] || [])[0] }}"
            },
            {
              "id": "p2",
              "name": "cutoff",
              "type": "string",
              "value": "={{ $(\"Collect Suppliers\").first().json.suppliers.find(s => s.fields.Supplier === ($json.fields[\"Supplier Name\"] || [])[0])?.fields.Cutoff ?? \"\" }}"
            },
            {
              "id": "p3",
              "name": "storageRank",
              "type": "number",
              "value": "={{ ({ \"חדר ירקות\": 1, \"מקרר\": 2, \"מקפיא\": 3, \"מחסן יבש\": 4 })[$json.fields.Storage] ?? 9 }}"
            },
            {
              "id": "p4",
              "name": "sortKey",
              "type": "number",
              "value": "={{ $json.fields.Sort ?? 99 }}"
            },
            {
              "id": "p5",
              "name": "item",
              "type": "string",
              "value": "={{ $json.fields.Item }}"
            },
            {
              "id": "p6",
              "name": "line",
              "type": "string",
              "value": "=• {{ $json.fields.Item }} ({{ $json.fields[\"Count Unit\"] }}) · {{ $json.fields.Storage }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cc0fa5ae-dfc8-4099-9c96-58e8de29a009",
      "name": "Sort By Cutoff And Storage",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [
        1344,
        96
      ],
      "parameters": {
        "type": "simple",
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "cutoff",
              "order": "ascending"
            },
            {
              "fieldName": "supplier",
              "order": "ascending"
            },
            {
              "fieldName": "storageRank",
              "order": "ascending"
            },
            {
              "fieldName": "sortKey",
              "order": "ascending"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cdea6403-9ab2-4657-b3ae-b7c8e8eba553",
      "name": "Group By Supplier",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        1568,
        96
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "concatenate",
              "field": "line",
              "separateBy": "\n"
            },
            {
              "aggregation": "count",
              "field": "item"
            }
          ]
        },
        "fieldsToSplitBy": "supplier,cutoff",
        "options": {}
      }
    },
    {
      "id": "97734110-cc4b-40d6-b459-7a219dae0ab8",
      "name": "Build Count Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1792,
        96
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "m1",
              "name": "message",
              "type": "string",
              "value": "=<b>ספירה להזמנה – {{ $json.supplier.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\") }}</b>\nההזמנה נסגרת ב-{{ $json.cutoff }}. {{ $json.count_item }} פריטים לספור:\n\n{{ $json.concatenated_line.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\") }}\n\nלהחזיר שורה לכל פריט: שם וכמות. למשל: עגבניות 4"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c400ed2f-5c58-4532-a48e-0f2538e635e4",
      "name": "Send Count List",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2016,
        96
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "retryOnFail": true,
      "webhookId": "addaa3d1-c7bd-4f2b-b069-98ba2853c1b1"
    },
    {
      "id": "e19666e8-3701-4097-8099-16b073f6c89f",
      "name": "Sticky Note 9645392b",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ],
      "parameters": {
        "content": "## DEMO R1a - Daily Count List\nכל יום ב-08:00: איזה יום היום -> ספקים שמזמינים היום (Airtable) -> הפריטים שלהם -> סידור לפי שעת סגירה ומקום אחסון -> רשימת ספירה לכל ספק.\nאין ספקים היום -> לא נשלחת הודעה.\nהספירה חוזרת ל-DEMO R1b, שמחשב טיוטת הזמנה.\nצריך: Airtable, Telegram.",
        "color": 4,
        "width": 560,
        "height": 260
      }
    }
  ],
